<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/lab_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="@string/lab_title"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_header"
        app:layout_constraintBottom_toTopOf="@id/content_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread"
        app:layout_constraintVertical_weight="1.0" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/content_margin"
        android:layout_marginEnd="@dimen/content_margin"
        android:background="@color/white"
        app:layout_constraintBottom_toTopOf="@id/application_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lab_title"
        app:layout_constraintVertical_weight="2.0">

        <TextView
            android:id="@+id/layout_title"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:text="@string/layout_title"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_title"
            app:layout_constraintBottom_toTopOf="@id/word_this"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread"
            app:layout_constraintVertical_weight="0.7" />

        <TextView
            android:id="@+id/word_this"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/red_panel"
            android:gravity="center"
            android:text="@string/word_this"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_panel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/word_is"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_title"
            app:layout_constraintVertical_weight="1.0" />

        <TextView
            android:id="@+id/word_is"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/blue_panel"
            android:gravity="center"
            android:text="@string/word_is"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_panel"
            app:layout_constraintBottom_toBottomOf="@id/word_this"
            app:layout_constraintEnd_toStartOf="@id/word_my"
            app:layout_constraintHorizontal_weight="1.0"
            app:layout_constraintStart_toEndOf="@id/word_this"
            app:layout_constraintTop_toTopOf="@id/word_this" />

        <TextView
            android:id="@+id/word_my"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/purple_panel"
            android:gravity="center"
            android:text="@string/word_my"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_panel"
            app:layout_constraintBottom_toBottomOf="@id/word_this"
            app:layout_constraintEnd_toStartOf="@id/word_first"
            app:layout_constraintHorizontal_weight="1.0"
            app:layout_constraintStart_toEndOf="@id/word_is"
            app:layout_constraintTop_toTopOf="@id/word_this" />

        <TextView
            android:id="@+id/word_first"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/yellow_panel"
            android:gravity="center"
            android:text="@string/word_first"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_panel"
            app:layout_constraintBottom_toBottomOf="@id/word_this"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1.0"
            app:layout_constraintStart_toEndOf="@id/word_my"
            app:layout_constraintTop_toTopOf="@id/word_this" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/application_message"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="@string/application_message"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_body"
        app:layout_constraintBottom_toTopOf="@id/button_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/content_panel"
        app:layout_constraintVertical_weight="2.6" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/button_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/content_margin"
        android:layout_marginEnd="@dimen/content_margin"
        android:background="@color/system_bar_surface"
        android:paddingStart="@dimen/content_margin"
        android:paddingTop="@dimen/button_vertical_margin"
        android:paddingEnd="@dimen/content_margin"
        android:paddingBottom="@dimen/button_vertical_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/application_message"
        app:layout_constraintVertical_weight="1.1">

        <Button
            android:id="@+id/change_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/button_gap_half"
            android:background="@drawable/button_background"
            android:gravity="center"
            android:minHeight="@dimen/button_min_height"
            android:minWidth="0dp"
            android:paddingStart="@dimen/button_horizontal_padding"
            android:paddingEnd="@dimen/button_horizontal_padding"
            android:text="@string/change"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cancel_button"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ButtonStyle" />

        <Button
            android:id="@+id/cancel_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/button_gap_half"
            android:background="@drawable/button_background"
            android:gravity="center"
            android:minHeight="@dimen/button_min_height"
            android:minWidth="0dp"
            android:paddingStart="@dimen/button_horizontal_padding"
            android:paddingEnd="@dimen/button_horizontal_padding"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1.0"
            app:layout_constraintStart_toEndOf="@id/change_button"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ButtonOrder,ButtonStyle" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

